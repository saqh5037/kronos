# =============================================================================
# Kronos — variables de entorno de PRODUCCIÓN
# =============================================================================
# Copiar como `.env` en el servidor (NO en el repo).
# Generar secrets con: openssl rand -base64 32
# Permisos: chmod 600 .env
# =============================================================================

# --- Core ---
NODE_ENV="production"
PORT="3000"

# --- Database (Postgres) ---
# RDS: postgresql://USER:PASS@kronos.xxxxx.us-east-1.rds.amazonaws.com:5432/kronos
# Self-hosted: postgresql://kronos:STRONG_PASS@127.0.0.1:5432/kronos
DATABASE_URL=""

# --- NextAuth ---
NEXTAUTH_URL="https://www.kronos-fit.com"
NEXTAUTH_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Kronos <noreply@kronos-fit.com>"

# Magic link SMTP (no se usa si Resend está activo, pero NextAuth EmailProvider
# requiere la var. Apuntar al mismo Resend SMTP o dejar vacío para fallback).
EMAIL_SERVER=""

# --- Cron jobs (Bearer token para /api/cron/*) ---
CRON_SECRET=""

# --- Dev login OFF en prod (crítico) ---
NEXT_PUBLIC_DEV_LOGIN="0"
DEV_PASSWORD=""

# --- Sentry (opcional — se puede activar después) ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- PostHog (opcional) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Storage (foto pizarra OCR) ---
# "local": filesystem (bind mount o volumen) — OK para MVP
# "s3": AWS S3 — requiere bucket + credenciales abajo
STORAGE_DRIVER="local"
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_PUBLIC_HOST=""

# --- Gemini Vision (OCR — opcional) ---
GEMINI_API_KEY=""

# --- Web Push (PWA — opcional) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@kronos-fit.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- MercadoPago (pagos — opcional para primer deploy) ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
MP_BACK_URL_BASE="https://www.kronos-fit.com"
