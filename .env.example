# Database (docker-compose starts Postgres on :5434)
DATABASE_URL="postgresql://kronos:kronos_dev@localhost:5434/kronos_db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-output"

# Google OAuth (optional — for Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic link (any SMTP)
# For dev: use https://ethereal.email or skip and use Dev Login (below)
EMAIL_SERVER=""
EMAIL_FROM="noreply@kronos.app"

# Dev Login (NODE_ENV=development only) — enables CredentialsProvider for demos
# Seeded users: owner@iron-hands.demo, coach@iron-hands.demo, atleta@iron-hands.demo
NEXT_PUBLIC_DEV_LOGIN="1"
DEV_PASSWORD="dev"

# Sentry (optional for local dev)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog (optional for local dev)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
