# Database (docker-compose starts Postgres on :5434)
DATABASE_URL="postgresql://kronos:kronos_dev@localhost:5434/kronos_db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-output"

# Google OAuth (optional — for Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic link (any SMTP) — usado por NextAuth EmailProvider
# For dev: use https://ethereal.email or skip and use Dev Login (below)
EMAIL_SERVER=""
EMAIL_FROM="Kronos <noreply@kronos.app>"

# Resend API key — si está vacío, sendEmail() cae al mock console.log
# Obtener en https://resend.com → API Keys
RESEND_API_KEY=""

# Cron secret — protege /api/cron/dispatch-announcements
# Si está vacío el endpoint responde 503 (desactivado).
# Vercel Cron lo inyecta automáticamente vía `vercel env`; en self-hosted
# generar con: openssl rand -base64 32
CRON_SECRET=""

# Dev Login (NODE_ENV=development only) — enables CredentialsProvider for demos
# Seeded users: owner@iron-hands.demo, coach@iron-hands.demo, atleta@iron-hands.demo
NEXT_PUBLIC_DEV_LOGIN="1"
DEV_PASSWORD="dev"

# Sentry (optional for local dev)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog (optional for local dev)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Storage driver — para almacenamiento de fotos de pizarra (OCR)
# - "local" (default): filesystem en public/uploads/, server-side fetch funciona en dev
# - "s3": AWS S3, requiere AWS_S3_BUCKET + credenciales abajo
STORAGE_DRIVER="local"

# AWS S3 — solo necesario si STORAGE_DRIVER=s3
# Bucket debe existir y permitir public-read si quieres URLs accesibles
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Opcional: CDN o dominio custom delante del bucket (CloudFront, etc)
AWS_S3_PUBLIC_HOST=""

# Gemini Vision — para OCR de pizarras
# Obtener en https://aistudio.google.com/app/apikey
# Sin este token, processWhiteboardUpload lanza error descriptivo
GEMINI_API_KEY=""

# Web Push (PWA notifications) — VAPID keys
# Generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY también debe ir en NEXT_PUBLIC_VAPID_PUBLIC_KEY para el client
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@kronos.app"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# MercadoPago — credenciales de testing
# Crear en https://www.mercadopago.com.mx/developers → Tu integración → Credenciales
# Si vacío, los endpoints MP responden 503 (desactivado).
MERCADOPAGO_ACCESS_TOKEN=""
# Webhook secret — panel MP → Webhooks → Configurar notificaciones → Secret
MERCADOPAGO_WEBHOOK_SECRET=""
# Base URL para back_urls del checkout (auto_return solo si HTTPS)
MP_BACK_URL_BASE="http://localhost:3000"
