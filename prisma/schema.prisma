  reason    String?

  @@index([boxId])
}

// ─── LANDING LEADS ───────────────────────────────────────────────────────────

model Lead {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  createdAt    DateTime @default(now()) @map("created_at")
  ownerName    String   @map("owner_name")
  email        String
  whatsapp     String
  boxName      String   @map("box_name")
