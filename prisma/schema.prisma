// ─── WEARABLES ────────────────────────────────────────────────────────────────
// Whoop (Fase 0). Garmin / Apple Health / Oura quedan reservados en el enum
// pero sin implementación. Tokens cifrados AES-256-GCM via token-vault.

enum WearableProvider {
  WHOOP
  GARMIN
  APPLE_HEALTH
  OURA
}

enum WearableStatus {
  CONNECTED
  REVOKED
  ERROR
  RECONNECT_REQUIRED
}

model WearableConnection {
  id               String           @id @default(cuid())
  tenantId         String
  athleteId        String
  provider         WearableProvider
  externalUserId   String
  accessToken      String           @db.Text
  refreshToken     String           @db.Text
  expiresAt        DateTime
  scopes           String[]
  status           WearableStatus   @default(CONNECTED)
  lastSyncedAt     DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([provider, externalUserId])
  @@unique([athleteId, provider])
  @@index([tenantId, status])
  @@index([tenantId, athleteId])
}

model WhoopCycle {
  id         String    @id @default(cuid())
  tenantId   String
  athleteId  String
  externalId String    @unique
  start      DateTime
  end        DateTime?
  strain     Float?
  kilojoule  Float?
  averageHr  Int?
  maxHr      Int?
  scoreState String?
  raw        Json
  syncedAt   DateTime  @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([tenantId, athleteId, start])
}

model WhoopRecovery {
  id              String   @id @default(cuid())
  tenantId        String
  athleteId       String
  cycleExternalId String   @unique
  sleepExternalId String?
  recoveredAt     DateTime
  score           Int?
  hrvRmssd        Float?
  restingHr       Int?
  spo2            Float?
  skinTempC       Float?
  raw             Json
  syncedAt        DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([tenantId, athleteId, recoveredAt])
}

model WhoopSleep {
  id            String   @id @default(cuid())
  tenantId      String
  athleteId     String
  externalId    String   @unique
  start         DateTime
  end           DateTime
  nap           Boolean  @default(false)
  performance   Int?
  efficiency    Float?
  totalInBedMs  Int?
  totalAsleepMs Int?
  disturbances  Int?
  raw           Json
  syncedAt      DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([tenantId, athleteId, start])
}

model WhoopWorkout {
  id             String   @id @default(cuid())
  tenantId       String
  athleteId      String
  externalId     String   @unique
  sportId        Int?
  start          DateTime
  end            DateTime
  strain         Float?
  averageHr      Int?
  maxHr          Int?
  kilojoule      Float?
  zoneDurationMs Json?
  scoreId        String?  @unique
  raw            Json
  syncedAt       DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  score   Score?  @relation(fields: [scoreId], references: [id], onDelete: SetNull)

  @@index([tenantId, athleteId, start])
}

// ─── SPORT EVENTS (PLATFORM-LEVEL, CROSS-TENANT) ─────────────────────────────
// Eventos deportivos administrados por Kronos / partner (Dominus, etc.).
// `SportEvent` NO lleva tenantId — un evento aparece para TODOS los boxes.
// `EventEntry` sí guarda tenantId del atleta al momento de inscribirse, para
// auditoría ("¿qué box trajo a este atleta al evento?").
// Inscripción self-service vía `accessToken` (código QR). Cualquier atleta
// autenticado que escanee el QR queda registrado.
enum EventScoreType {
  TIME
  REPS
  ROUNDS_REPS
  WEIGHT
  TEXT
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model SportEvent {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  partnerName String?
  description String?
  coverUrl    String?
  startDate   DateTime
  endDate     DateTime?
  scoreType   EventScoreType
  scoreUnit   String?
  divisions   String[]
  accessToken String         @unique
  status      EventStatus    @default(DRAFT)
  kitUrl      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  entries EventEntry[]

  @@index([accessToken])
  @@index([status])
}

model EventEntry {
  id            String    @id @default(cuid())
  eventId       String
  athleteId     String
  tenantId      String
  division      String?
  scoreValue    Decimal?  @db.Decimal(10, 2)
  scoreText     String?
  notes         String?
  mediaUrl      String?
  mediaPathname String?
  registeredVia String?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event   SportEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
  @@index([eventId])
  @@index([athleteId])
  @@index([tenantId])
}
