// ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
