// ─── ATHLETE INVITATIONS ──────────────────────────────────────────────────────

model AthleteInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  firstName   String?
  lastName    String?
  phone       String?
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
