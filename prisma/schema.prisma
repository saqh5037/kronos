// ─── SAAS BILLING ─────────────────────────────────────────────────────────────

enum SaasSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model SaasPlan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  priceMxnCents Int      @default(0)
  maxAthletes   Int?
  maxCoaches    Int?
  features      Json
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  subscriptions SaasSubscription[]
}

model SaasSubscription {
  id               String                 @id @default(cuid())
  tenantId         String
  planId           String
  status           SaasSubscriptionStatus @default(PENDING)
  startsAt         DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  mpPreferenceId   String?                @unique
  mpSubscriptionId String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  box      Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SaasPlan      @relation(fields: [planId], references: [id])
  invoices SaasInvoice[]

  @@index([tenantId])
  @@index([tenantId, status])
}

enum SaasInvoiceStatus {
  PAID
  REFUNDED
}

model SaasInvoice {
  id             String            @id @default(cuid())
  tenantId       String
  subscriptionId String
  amountMxnCents Int
  status         SaasInvoiceStatus @default(PAID)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime
  mpPaymentId    String?           @unique
  createdAt      DateTime          @default(now())

  box          Box              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, paidAt(sort: Desc)])
}

// ─── ATHLETE ALIASES ──────────────────────────────────────────────────────────

model AthleteAlias {
  id          String   @id @default(cuid())
  tenantId    String
  athleteId   String
  alias       String
  createdById String?
  createdAt   DateTime @default(now())

  box       Box     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AliasCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, alias])
  @@index([tenantId, athleteId])
}

// ─── IN-APP NOTIFICATIONS ─────────────────────────────────────────────────────

enum NotificationKind {
