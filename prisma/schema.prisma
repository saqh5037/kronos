generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT ──────────────────────────────────────────────────────────────────

model Box {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  locale       String   @default("es-MX")
  currency     String   @default("MXN")
  brandColor   String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  users           User[]
  athletes        Athlete[]
  membershipPlans MembershipPlan[]
  classes         Class[]
  wods            WOD[]
  movements       Movement[]
  badges          Badge[]
  payments        Payment[]
}

// ─── USERS / AUTH ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  COACH
  ATHLETE
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ATHLETE)
  tenantId      String

  box          Box       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
  athlete      Athlete?
  coachClasses Class[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ATHLETES ─────────────────────────────────────────────────────────────────

enum AthleteStatus {
  ACTIVE
  PAUSED
  DROPIN
  CANCELLED
}

model Athlete {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String?       @unique
  firstName        String
  lastName         String
  dob              DateTime?
  phone            String?
  emergencyContact String?
  healthHistory    String?
  status           AthleteStatus @default(ACTIVE)
  tags             String[]
  photoUrl         String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  box          Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  memberships  Membership[]
  bookings     Booking[]
  scores       Score[]
  prs          PR[]
  achievements Achievement[]
  streaks      Streak[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── MEMBERSHIPS ──────────────────────────────────────────────────────────────

enum PlanType {
  MONTHLY
  ANNUAL
  PACKAGE
  DROPIN
  UNLIMITED
  FAMILY
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model MembershipPlan {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  type            PlanType
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("MXN")
  classesPerMonth Int?
  durationDays    Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  box         Box          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([tenantId])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  athleteId String
  planId    String
  startDate DateTime
  endDate   DateTime?
  status    MembershipStatus @default(ACTIVE)
  autoRenew Boolean          @default(true)
  createdAt DateTime         @default(now())

  athlete  Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, athleteId])
}

// ─── SCHEDULE ─────────────────────────────────────────────────────────────────

enum BookingStatus {
  BOOKED
  WAITLIST
  ATTENDED
  NOSHOW
  CANCELLED
}

model Class {
  id             String   @id @default(cuid())
  tenantId       String
  startsAt       DateTime
  durationMin    Int      @default(60)
  capacity       Int      @default(16)
  coachId        String?
  wodId          String?
  recurrenceRule String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  box      Box       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coach    User?     @relation(fields: [coachId], references: [id])
  wod      WOD?      @relation(fields: [wodId], references: [id])
  bookings Booking[]

  @@index([tenantId])
  @@index([tenantId, startsAt])
}

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  classId     String
  athleteId   String
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now())
  checkedInAt DateTime?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([classId, athleteId])
  @@index([tenantId])
  @@index([tenantId, athleteId])
}

// ─── WODs ─────────────────────────────────────────────────────────────────────

enum WODType {
  FORTIME
  AMRAP
  EMOM
  TABATA
  STRENGTH
  CUSTOM
}

enum ScoreType {
  TIME
  REPS
  WEIGHT
  ROUNDS_REPS
}

enum Scaling {
  RX
  SCALED
  RXPLUS
}

model WOD {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  type         WODType
  description  String?
  scoreType    ScoreType @default(TIME)
  scaleOptions Json?
  timeCap      Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  box       Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes   Class[]
  scores    Score[]
  movements WODMovement[]

  @@index([tenantId])
}

model Movement {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  videoUrl            String?
  standardDescription String?
  equipment           String[]
  createdAt           DateTime @default(now())

  box          Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wodMovements WODMovement[]
  prs          PR[]

  @@index([tenantId])
}

model WODMovement {
  id         String   @id @default(cuid())
  wodId      String
  movementId String
  reps       Int?
  weight     Decimal? @db.Decimal(6, 2)
  notes      String?
  order      Int      @default(0)

  wod      WOD      @relation(fields: [wodId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id])

  @@unique([wodId, movementId])
}

model Score {
  id        String   @id @default(cuid())
  tenantId  String
  wodId     String
  athleteId String
  classId   String?
  value     Decimal  @db.Decimal(10, 3)
  unit      String
  scaling   Scaling  @default(RX)
  notes     String?
  mediaUrl  String?
  createdAt DateTime @default(now())

  wod     WOD     @relation(fields: [wodId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, wodId])
  @@index([tenantId, athleteId])
}

model PR {
  id         String   @id @default(cuid())
  tenantId   String
  athleteId  String
  movementId String
  value      Decimal  @db.Decimal(10, 3)
  unit       String
  achievedAt DateTime @default(now())

  athlete  Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id])

  @@index([tenantId])
  @@index([tenantId, athleteId])
  @@unique([athleteId, movementId])
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  MERCADOPAGO
  STRIPE
  CASH
}

model Payment {
  id           String         @id @default(cuid())
  tenantId     String
  membershipId String?
  amount       Decimal        @db.Decimal(10, 2)
  currency     String         @default("MXN")
  gateway      PaymentGateway
  status       PaymentStatus  @default(PENDING)
  externalId   String?
  paidAt       DateTime?
  createdAt    DateTime       @default(now())

  box        Box         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([tenantId])
}

// ─── GAMIFICATION ─────────────────────────────────────────────────────────────

enum StreakType {
  ATTENDANCE
  PR
}

model Badge {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String
  iconUrl     String?
  criteria    Json
  createdAt   DateTime @default(now())

  box          Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Achievement {
  id        String   @id @default(cuid())
  tenantId  String
  athleteId String
  badgeId   String
  earnedAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id])

  @@unique([athleteId, badgeId])
  @@index([tenantId])
}

model Streak {
  id          String     @id @default(cuid())
  tenantId    String
  athleteId   String
  type        StreakType
  count       Int        @default(0)
  lastEventAt DateTime?

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, type])
  @@index([tenantId])
}

// ─── AUDIT ────────────────────────────────────────────────────────────────────

enum AuditAction {
  CLASS_CANCELLED
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_CHECKIN
  BOOKING_NOSHOW
  WAITLIST_PROMOTED
  SCORE_SUBMITTED
  PR_ACHIEVED
  WOD_ARCHIVED
  PLAN_ARCHIVED
  MEMBERSHIP_ASSIGNED
  MEMBERSHIP_PAUSED
  MEMBERSHIP_CANCELLED
  PAYMENT_REGISTERED
  PAYMENT_VOIDED
}

model AuditEvent {
  id         String      @id @default(cuid())
  tenantId   String
  actorId    String? // user who triggered the event (null = system)
  action     AuditAction
  targetType String // "Class", "Booking", "Score", etc.
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, actorId])
}

// ─── COMMUNICATIONS ───────────────────────────────────────────────────────────

enum AnnouncementAudience {
  ALL
  ACTIVE
  PAUSED
  COACHES
}

enum AnnouncementChannel {
  EMAIL
  PUSH
  IN_APP
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Announcement {
  id          String               @id @default(cuid())
  tenantId    String
  title       String
  body        String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  channel     AnnouncementChannel  @default(IN_APP)
  status      AnnouncementStatus   @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipientCount Int               @default(0)
  authorId    String?
  createdAt   DateTime             @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}
