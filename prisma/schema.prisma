generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── TENANT ──────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// Multi-disciplina: cada Box practica UNA disciplina primaria (CrossFit, Hyrox,
// Yoga, Pilates, etc.). Agregar nueva disciplina = INSERT en esta tabla + nueva
// clase DisciplineStrategy en src/lib/disciplines/{slug}.ts + entry en
// src/lib/branding/index.ts. Cero migrations adicionales.
//
// `measurements` y `leaderboardType` son hints semánticos para la UI; la
// validación dura vive en la DisciplineStrategy de TS.
model Discipline {
  id              String   @id @default(cuid())
  slug            String   @unique // "crossfit", "hyrox", "yoga", "pilates"
  name            String
  iconUrl         String?
  brandColor      String   @default("#c8ff2d")
  strategy        String // referencia a clase TS en src/lib/disciplines/{strategy}.ts
  measurements    Json // ej: ["TIME", "REPS", "WEIGHT", "ROUNDS_REPS"]
  leaderboardType String   @default("PR") // "PR" | "STREAK" | "CONSISTENCY"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  boxes           Box[]
  primaryAthletes Athlete[]  @relation("PrimaryDiscipline")
  wods            WOD[]
  movements       Movement[]

  @@index([slug])
  @@index([isActive])
}

model Box {
  id                         String             @id @default(cuid())
  slug                       String             @unique
  name                       String
  locale                     String             @default("es-MX")
  currency                   String             @default("MXN")
  timezone                   String             @default("America/Mexico_City")
  defaultClassCapacity       Int                @default(10)
  bookingOpenHoursAhead      Int                @default(24)
  cancelCloseMinBefore       Int                @default(30)
  weeklySchedule             Json?
  brandColor                 String?
  logoUrl                    String?
  trialStartedAt             DateTime?
  trialEndsAt                DateTime?
  trialLastNotifiedAt        DateTime?
  subscriptionStatus         SubscriptionStatus @default(TRIAL)
  onboardingCompletedAt      DateTime?
  weeklyDigestEnabled        Boolean            @default(true)
  transactionalEmailsEnabled Boolean            @default(true)
  createdAt                  DateTime           @default(now())

  // ─── Multi-disciplina + geofencing pilotos (F1.1, 2026-05-16) ───────────────
  // disciplineId nullable durante backfill — promover a NOT NULL en sprint
  // siguiente una vez que todos los Boxes existentes hayan sido backfilleados.
  disciplineId              String?
  country                   String    @default("MX")
  city                      String?
  region                    String?
  lat                       Float?
  lng                       Float?
  pilotExclusivityExpiresAt DateTime?
  pilotBetaSignedAt         DateTime?
  features                  Json      @default("{}")

  discipline              Discipline?              @relation(fields: [disciplineId], references: [id])
  users                   User[]
  athletes                Athlete[]
  membershipPlans         MembershipPlan[]
  classes                 Class[]
  wods                    WOD[]
  movements               Movement[]
  badges                  Badge[]
  payments                Payment[]
  webhookEvents           WebhookEvent[]
  permissions             Permission[]
  permissionGrantRequests PermissionGrantRequest[]
  alertRules              AlertRule[]
  whiteboardUploads       WhiteboardUpload[]
  athleteAliases          AthleteAlias[]
  athleteInvitations      AthleteInvitation[]
  staffInvitations        StaffInvitation[]
  saasSubscriptions       SaasSubscription[]
  saasInvoices            SaasInvoice[]

  @@index([disciplineId])
  @@index([city, disciplineId])
}

// ─── USERS / AUTH ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  COACH
  ATHLETE
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ATHLETE)
  tenantId      String

  passwordHash  String?
  passwordSetAt DateTime?

  box          Box       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
  athlete      Athlete?
  coachClasses Class[]

  permissionsUpdated    Permission[]             @relation("PermissionUpdatedBy")
  grantRequestsCreated  PermissionGrantRequest[] @relation("GrantRequestRequester")
  grantRequestsReviewed PermissionGrantRequest[] @relation("GrantRequestReviewer")
  whiteboardUploads     WhiteboardUpload[]       @relation("WhiteboardUploader")
  aliasesCreated        AthleteAlias[]           @relation("AliasCreatedBy")
  inAppNotifications    InAppNotification[]
  pushSubscriptions     PushSubscription[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String    @unique
  expires    DateTime
  consumedAt DateTime?

  @@unique([identifier, token])
}

// ─── ATHLETES ─────────────────────────────────────────────────────────────────

enum AthleteStatus {
  ACTIVE
  PAUSED
  DROPIN
  CANCELLED
}

model Athlete {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String?       @unique
  firstName        String
  lastName         String
  dob              DateTime?
  phone            String?
  emergencyContact String?
  healthHistory    String?
  status           AthleteStatus @default(ACTIVE)
  tags             String[]
  photoUrl         String?
  notes            String?

  // ─── Onboarding wizard (9 steps) ────────────────────────────────────────────
  onboardingStartedAt      DateTime?
  onboardingCompletedAt    DateTime?
  onboardingSkippedAt      DateTime?
  onboardingStep           Int                @default(0)
  fitnessReason            FitnessReason?
  biologicalSex            BiologicalSex?
  weightKg                 Float?
  heightCm                 Float?
  ageYears                 Int?
  trackMenstrualCycle      Boolean            @default(false)
  fitnessExperience        FitnessExperience?
  fitnessGoal              FitnessGoal?
  weeklyFrequency          Int?
  routinePreference        RoutinePreference?
  excludedMuscles          String[]
  trainingLocation         TrainingLocation?
  trainsOnOwnToo           Boolean            @default(false)
  pushNotificationsEnabled Boolean            @default(false)
  appleHealthLinkedAt      DateTime?

  // Wearables (Whoop / Garmin / Apple Health / Oura). Opt-in privacy.
  shareWearableWithCoach Boolean @default(false)

  // ─── Multi-disciplina (F1.1, 2026-05-16) ────────────────────────────────────
  // Primary discipline = la que el atleta más practica. F2 agregará M:M
  // Athlete↔Box, lo cual permitirá tener disciplinas adicionales via cada
  // membership.
  primaryDisciplineId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  box               Box                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryDiscipline Discipline?          @relation("PrimaryDiscipline", fields: [primaryDisciplineId], references: [id])
  user              User?                @relation(fields: [userId], references: [id])
  memberships       Membership[]
  bookings          Booking[]
  scores            Score[]
  prs               PR[]
  prAttempts        PRAttempt[]
  achievements      Achievement[]
  streaks           Streak[]
  goals             Goal[]
  bodyMetrics       BodyMetric[]
  aliases           AthleteAlias[]
  surveyResponses   SurveyResponse[]
  xpLedger          XPLedger[]
  dailyMissions     DailyMission[]
  skillLevels       AthleteSkillLevel[]
  wearables         WearableConnection[]
  whoopCycles       WhoopCycle[]
  whoopRecoveries   WhoopRecovery[]
  whoopSleeps       WhoopSleep[]
  whoopWorkouts     WhoopWorkout[]
  eventEntries      EventEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([primaryDisciplineId])
}

// ─── MEMBERSHIPS ──────────────────────────────────────────────────────────────

enum PlanType {
  MONTHLY
  ANNUAL
  PACKAGE
  DROPIN
  UNLIMITED
  FAMILY
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model MembershipPlan {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  type            PlanType
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("MXN")
  classesPerMonth Int?
  durationDays    Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  box         Box          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([tenantId])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  athleteId String
  planId    String
  startDate DateTime
  endDate   DateTime?
  status    MembershipStatus @default(ACTIVE)
  autoRenew Boolean          @default(true)
  createdAt DateTime         @default(now())

  athlete  Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, athleteId])
}

// ─── SCHEDULE ─────────────────────────────────────────────────────────────────

enum BookingStatus {
  BOOKED
  WAITLIST
  ATTENDED
  NOSHOW
  CANCELLED
}

enum ClassKind {
  WOD
  OPEN_BOX
}

model Class {
  id             String    @id @default(cuid())
  tenantId       String
  startsAt       DateTime
  durationMin    Int       @default(60)
  capacity       Int       @default(10)
  kind           ClassKind @default(WOD)
  coachId        String?
  wodId          String?
  recurrenceRule String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  box               Box                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coach             User?              @relation(fields: [coachId], references: [id])
  wod               WOD?               @relation(fields: [wodId], references: [id])
  bookings          Booking[]
  whiteboardUploads WhiteboardUpload[]

  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@index([tenantId, startsAt, isActive])
}

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  classId     String
  athleteId   String
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now())
  checkedInAt DateTime?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([classId, athleteId])
  @@index([tenantId])
  @@index([tenantId, athleteId])
  @@index([tenantId, classId, status])
  @@index([tenantId, athleteId, status])
}

// ─── WODs ─────────────────────────────────────────────────────────────────────

enum MovementCategory {
  STRENGTH
  GYMNASTICS
  MONOSTRUCTURAL
  OLYMPIC
  ACCESSORY
}

enum MovementContentSource {
  EMPTY
  STANDARD_SEED
  AI_GENERATED
  MANUAL_OVERRIDE
}

enum WODType {
  FORTIME
  AMRAP
  EMOM
  TABATA
  STRENGTH
  CUSTOM
}

enum ScoreType {
  TIME
  REPS
  WEIGHT
  ROUNDS_REPS
}

enum Scaling {
  RX
  SCALED
  RXPLUS
}

model WOD {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  type           WODType
  description    String?
  scoreType      ScoreType @default(TIME)
  scaleOptions   Json?
  timeCap        Int?
  isActive       Boolean   @default(true)
  /**
   * Optional date for personal-program WODs (atleta sin box).
   */
  scheduledFor   DateTime? @db.Date
  /**
   * When set, this WOD is part of an athlete's personal program.
   */
  ownerAthleteId String?
  createdAt      DateTime  @default(now())

  // ─── Multi-disciplina (F1.1, 2026-05-16) ────────────────────────────────────
  // Hereda de Box.discipline al crear pero se almacena explícito para queries
  // y para soportar WODs cross-disciplina futuros. F1.2 introducirá `Session`
  // como evolución de WOD con payload validado por strategy.
  disciplineId String?

  box        Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discipline Discipline?   @relation(fields: [disciplineId], references: [id])
  classes    Class[]
  scores     Score[]
  movements  WODMovement[]

  @@index([tenantId])
  @@index([tenantId, ownerAthleteId, scheduledFor])
  @@index([disciplineId])
}

model Movement {
  id                  String           @id @default(cuid())
  tenantId            String
  name                String
  slug                String
  category            MovementCategory @default(ACCESSORY)
  isStandard          Boolean          @default(false)
  videoUrl            String?
  videoUrlCues        String?
  standardDescription String?
  equipment           String[]
  createdAt           DateTime         @default(now())

  cues           Json?
  commonMistakes Json?
  progressions   Json?
  musclesWorked  String[]
  difficulty     Int?

  contentSource      MovementContentSource @default(EMPTY)
  contentGeneratedAt DateTime?

  // ─── Multi-disciplina (F1.1, 2026-05-16) ────────────────────────────────────
  // disciplineId null = movimiento agnóstico (ej. running, rowing comparten
  // CrossFit y Hyrox). disciplineId set = movimiento exclusivo de esa
  // disciplina (ej. snatch solo CrossFit, sled push solo Hyrox).
  disciplineId String?

  box          Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discipline   Discipline?   @relation(fields: [disciplineId], references: [id])
  wodMovements WODMovement[]
  prs          PR[]
  prAttempts   PRAttempt[]
  goals        Goal[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, disciplineId])
}

model WODMovement {
  id         String   @id @default(cuid())
  wodId      String
  movementId String
  reps       Int?
  weight     Decimal? @db.Decimal(6, 2)
  notes      String?
  order      Int      @default(0)

  wod      WOD      @relation(fields: [wodId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id])

  @@unique([wodId, movementId])
}

model Score {
  id        String   @id @default(cuid())
  tenantId  String
  wodId     String
  athleteId String
  classId   String?
  value     Decimal  @db.Decimal(10, 3)
  unit      String
  scaling   Scaling  @default(RX)
  notes     String?
  mediaUrl  String?
  createdAt DateTime @default(now())

  wod          WOD           @relation(fields: [wodId], references: [id])
  athlete      Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  whoopWorkout WhoopWorkout?

  @@index([tenantId])
  @@index([tenantId, wodId])
  @@index([tenantId, athleteId])
  @@index([tenantId, wodId, scaling])
}

model PR {
  id         String   @id @default(cuid())
  tenantId   String
  athleteId  String
  movementId String
  value      Decimal  @db.Decimal(10, 3)
  unit       String
  achievedAt DateTime @default(now())

  athlete  Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id])

  @@unique([athleteId, movementId])
  @@index([tenantId])
  @@index([tenantId, athleteId])
}

/// Append-only log of every PR improvement.
/// Each row represents a moment when the athlete beat their previous best
/// for a movement. Together with `PR` (current best, 1:1) this enables
/// progression charts, improvers ranking, activity feed and goal tracking.
model PRAttempt {
  id            String   @id @default(cuid())
  tenantId      String
  athleteId     String
  movementId    String
  scoreId       String?  @unique
  value         Decimal  @db.Decimal(10, 3)
  unit          String
  prevBest      Decimal? @db.Decimal(10, 3)
  isCurrentBest Boolean  @default(true)
  achievedAt    DateTime @default(now())

  athlete  Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id])

  @@index([tenantId])
  @@index([tenantId, athleteId])
  @@index([tenantId, athleteId, movementId, achievedAt])
}

// ─── GOALS ────────────────────────────────────────────────────────────────────

enum GoalMetric {
  PR
  TONNAGE
  ATTENDANCE
  BODY_COMPOSITION
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  EXPIRED
  CANCELLED
}

model Goal {
  id          String     @id @default(cuid())
  tenantId    String
  athleteId   String
  movementId  String?
  metric      GoalMetric
  targetValue Decimal    @db.Decimal(10, 3)
  unit        String
  startValue  Decimal?   @db.Decimal(10, 3)
  deadline    DateTime
  status      GoalStatus @default(ACTIVE)
  achievedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  athlete  Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  movement Movement? @relation(fields: [movementId], references: [id])

  @@index([tenantId])
  @@index([tenantId, athleteId])
  @@index([tenantId, athleteId, status])
}

// ─── BODY METRICS ─────────────────────────────────────────────────────────────

model BodyMetric {
  id         String   @id @default(cuid())
  tenantId   String
  athleteId  String
  type       String // WEIGHT | BODY_FAT | MUSCLE_MASS | BMI | CUSTOM
  label      String? // free text when type=CUSTOM
  value      Decimal  @db.Decimal(10, 3)
  unit       String
  measuredAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, athleteId, type, measuredAt])
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  MERCADOPAGO
  STRIPE
  CASH
}

model Payment {
  id             String         @id @default(cuid())
  tenantId       String
  membershipId   String?
  amount         Decimal        @db.Decimal(10, 2)
  currency       String         @default("MXN")
  gateway        PaymentGateway
  status         PaymentStatus  @default(PENDING)
  externalId     String?        @unique
  mpPreferenceId String?        @unique
  mpStatus       String?
  mpStatusDetail String?
  mpPaymentType  String?
  mpPayerEmail   String?
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  box           Box            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership?    @relation(fields: [membershipId], references: [id])
  webhookEvents WebhookEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, gateway])
}

model WebhookEvent {
  id               String    @id @default(cuid())
  tenantId         String?
  source           String
  externalId       String?
  rawPayload       Json
  rawHeaders       Json?
  signatureValid   Boolean?
  processingStatus String
  errorMsg         String?
  paymentId        String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  box     Box?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([source, receivedAt])
  @@index([externalId])
  @@index([processingStatus])
}

// ─── GAMIFICATION ─────────────────────────────────────────────────────────────

enum StreakType {
  ATTENDANCE
  PR
}

enum BadgeTier {
  PRINCIPIANTE
  ESCALADO
  RX
}

model Badge {
  id          String     @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String
  iconUrl     String?
  criteria    Json
  tier        BadgeTier?
  xpReward    Int        @default(50)
  createdAt   DateTime   @default(now())

  box          Box           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Achievement {
  id        String   @id @default(cuid())
  tenantId  String
  athleteId String
  badgeId   String
  earnedAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id])

  @@unique([athleteId, badgeId])
  @@index([tenantId])
}

// ─── SKILL PROGRESSIONS ──────────────────────────────────────────────────────

enum SkillLevelStatus {
  CURRENT
  ACHIEVED
}

model AthleteSkillLevel {
  id              String           @id @default(cuid())
  tenantId        String
  athleteId       String
  movementSlug    String
  progressionSlug String
  status          SkillLevelStatus
  achievedAt      DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, movementSlug, progressionSlug])
  @@index([tenantId, athleteId])
  @@index([tenantId, movementSlug])
}

// ─── COACH VIRTUAL CARDS ─────────────────────────────────────────────────────

enum CoachCardType {
  STAGNATION
  NEXT_UNLOCK
  AVOIDANCE_PATTERN
  CELEBRATION
}

model CoachCard {
  id          String        @id @default(cuid())
  tenantId    String
  athleteId   String
  type        CoachCardType
  title       String
  body        String
  ctaLabel    String?
  ctaHref     String?
  meta        Json?
  generatedAt DateTime      @default(now())
  validUntil  DateTime
  dismissed   Boolean       @default(false)
  dismissedAt DateTime?
  priority    Int           @default(50)

  @@index([tenantId, athleteId, dismissed, validUntil])
  @@index([validUntil])
}

model Streak {
  id          String     @id @default(cuid())
  tenantId    String
  athleteId   String
  type        StreakType
  count       Int        @default(0)
  lastEventAt DateTime?

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, type])
  @@index([tenantId])
}

model XPLedger {
  id         String   @id @default(cuid())
  tenantId   String
  athleteId  String
  amount     Int
  reason     String
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, reason])
  @@index([tenantId, athleteId, createdAt])
}

model DailyMission {
  id        String   @id @default(cuid())
  tenantId  String
  athleteId String
  date      DateTime @db.Date
  missions  Json
  completed Json     @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, date])
  @@index([tenantId, date])
}

// ─── RBAC PARAMETRIZABLE ──────────────────────────────────────────────────────

enum PermissionAction {
  REGISTER_CASH_PAYMENT
  APPLY_DISCOUNT
  REFUND_PAYMENT
  EDIT_PLAN_PRICING
  DELETE_ATHLETE
  MARK_OVERDUE
  VIEW_FINANCIAL_REPORTS
  EDIT_OTHERS_SCORES
  MANAGE_ATHLETE_METRICS
}

model Permission {
  id                    String           @id @default(cuid())
  tenantId              String
  action                PermissionAction
  allowedRoles          Role[]
  requiresOwnerApproval Boolean          @default(false)
  threshold             Decimal?         @db.Decimal(10, 2)
  updatedAt             DateTime         @updatedAt
  updatedById           String?

  box       Box   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([tenantId, action])
  @@index([tenantId])
}

enum GrantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model PermissionGrantRequest {
  id          String             @id @default(cuid())
  tenantId    String
  requesterId String
  action      PermissionAction
  targetType  String
  targetId    String
  payload     Json
  status      GrantRequestStatus @default(PENDING)
  reviewerId  String?
  reviewedAt  DateTime?
  reason      String?
  createdAt   DateTime           @default(now())
  expiresAt   DateTime

  box       Box   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester User  @relation("GrantRequestRequester", fields: [requesterId], references: [id])
  reviewer  User? @relation("GrantRequestReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── ALERT RULES ──────────────────────────────────────────────────────────────

enum AlertChannel {
  EMAIL
  PUSH
  IN_APP
  BOTH
}

model AlertRule {
  id           String       @id @default(cuid())
  tenantId     String
  action       AuditAction
  channel      AlertChannel @default(EMAIL)
  threshold    Decimal?     @db.Decimal(10, 2)
  enabled      Boolean      @default(true)
  recipientIds String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  box Box @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, action])
  @@index([tenantId])
}

// ─── AUDIT ────────────────────────────────────────────────────────────────────

enum AuditAction {
  CLASS_CANCELLED
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_CHECKIN
  BOOKING_NOSHOW
  WAITLIST_PROMOTED
  SCORE_SUBMITTED
  PR_ACHIEVED
  WOD_ARCHIVED
  PLAN_ARCHIVED
  MEMBERSHIP_ASSIGNED
  MEMBERSHIP_PAUSED
  MEMBERSHIP_CANCELLED
  PAYMENT_REGISTERED
  PAYMENT_VOIDED
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  WEBHOOK_RECEIVED
  WHITEBOARD_UPLOADED
  BULK_SCORES_FROM_WHITEBOARD
  USER_LOGIN
  USER_LOGOUT
  PASSWORD_SET
  PASSWORD_CLEARED
  ATHLETE_ONBOARDING_STEP_COMPLETED
  ATHLETE_ONBOARDING_COMPLETED
  ATHLETE_ONBOARDING_SKIPPED
  PILOT_BETA_SIGNED
  WEARABLE_CONNECTED
  WEARABLE_DISCONNECTED
  WEARABLE_SYNC_FAILED
  WEARABLE_RECONNECT_REQUIRED
  ATHLETE_QUICK_WOD_SAVED
}

model AuditEvent {
  id         String      @id @default(cuid())
  tenantId   String
  actorId    String? // user who triggered the event (null = system)
  action     AuditAction
  targetType String // "Class", "Booking", "Score", etc.
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, actorId])
}

// ─── WHITEBOARD OCR ───────────────────────────────────────────────────────────

enum WhiteboardStatus {
  PENDING
  PROCESSED
  CONFIRMED
  EXPIRED
  FAILED
}

model WhiteboardUpload {
  id             String           @id @default(cuid())
  tenantId       String
  classId        String
  uploaderId     String
  url            String
  blobPathname   String?
  status         WhiteboardStatus @default(PENDING)
  aiResult       Json?
  confirmedCount Int              @default(0)
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  processedAt    DateTime?
  confirmedAt    DateTime?

  box      Box   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class    Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  uploader User  @relation("WhiteboardUploader", fields: [uploaderId], references: [id])

  @@index([tenantId, classId])
  @@index([tenantId])
